#!/bin/bash

set -eou pipefail

REGISTRY=registry.wcooke.me:5000
REPO=repo-sync-iso/repo-sync-iso
VERSION=1

podman buildx prune --all --force
podman build -t ${REGISTRY}/${REPO}:${VERSION} .
podman image push ${REGISTRY}/${REPO}:${VERSION}

sed -i "s@ image: ${REGISTRY}/${REPO}:.*@ image: ${REGISTRY}/${REPO}:${VERSION}@g" base/repo-sync-iso-cronjob.yaml
